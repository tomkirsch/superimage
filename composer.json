{
    "name": "tomkirsch/superimage",
    "type": "library",
    "description": "SuperImage Library for CodeIgniter4",
    "require": {
        "php": "^8.0",
        "codeigniter4/framework": "^4"
    },
    "autoload": {
        "psr-4": {
            "Tomkirsch\\SuperImage\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "tests"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10 || ^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Tomkirsch\\SuperImage\\Tests\\": "tests/"
        }
    }
}